# Copy this file to ".env" in this folder (backend/db) and replace the line below with the URL
# you were given privately. ".env" is git-ignored; this example file is safe to commit.
#
# The role is sojourner_app, the least-privilege role created by schema.sql. Not the admin.
# Never put a real password in this file. Never commit ".env".
TIMESCALE_SERVICE_URL="postgres://sojourner_app:<password>@<host>:<port>/tsdb?sslmode=require"
